{
  "schemaVersion": 1,
  "id": "wywf",
  "version": "${version}",
  "name": "What you Want to Find",
  "description": "Turn the world-creation Seed box into a natural-language search.",
  "authors": ["mermagudyan"],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/wywf",
    "sources": "https://github.com/mermagudyan/WyWF",
    "issues": "https://github.com/mermagudyan/WyWF/issues"
  },
  "license": "Apache-2.0",
  "icon": "assets/wywf/icon.png",
  "environment": "client",
  "accessWidener": "wywf.accesswidener",
  "entrypoints": {
    "client": ["com.wywf.WYWFClient"],
    "modmenu": ["com.wywf.client.ModMenuIntegration"]
  },
  "mixins": [
    "wywf.mixins.json",
    "wywf.client.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${min_loader_version}",
    "minecraft": "${mc_range}",
    "java": ">=25",
    "fabric-api": "*",
    "diylib": ">=0.1.0"
  },
  "suggests": {
    "modmenu": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.curseforge": "https://www.curseforge.com/minecraft/mc-mods/wywf",
        "modmenu.modrinth": "https://modrinth.com/mod/wywf",
        "modmenu.discord": "https://discord.gg/Y26ez5Vf7v"
      }
    }
  }
}
