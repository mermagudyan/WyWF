{
  "schemaVersion": 1,
  "id": "wywf",
  "version": "${version}",
  "name": "What you Want to Find",
  "description": "Turn the world-creation Seed box into a natural-language search.",
  "authors": ["mermagudyan"],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/wywf",
    "sources": "https://github.com/mermagudyan/WyWF",
    "issues": "https://github.com/mermagudyan/WyWF/issues"
  },
  "license": "Apache-2.0",
  "icon": "assets/wywf/icon.png",
  "environment": "client",
  "accessWidener": "wywf.accesswidener",
  "entrypoints": {
    "client": ["com.wywf.WYWFClient"],
    "modmenu": ["com.wywf.client.ModMenuIntegration"]
  },
  "mixins": [
    "wywf.mixins.json",
    "wywf.client.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": ">=1.21.1 <1.22",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*",
    "yet-another-config-lib": "*"
  }
}
